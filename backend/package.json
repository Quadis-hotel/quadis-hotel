{
  "name": "quadis-backend",
  "version": "1.0.0",
  "description": "Quadis Hotels Node.js + TypeScript API Server & Booking Engine",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql');require('fs').copyFileSync('src/db/global-bundle.pem','dist/db/global-bundle.pem')\"",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@google/genai": "^2.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.5",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
